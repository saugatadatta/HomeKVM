<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package (MSIX) for HomeKVM. The release workflow fills in the
  {PLACEHOLDERS} from repository variables (see STORE.md) and builds the package with
  makeappx. The same HomeKVM.exe runs inside; it notices it's packaged and then uses the
  startup task below for "Start when I sign in" and lets the Store handle updates.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>HomeKVM</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HomeKVM" Executable="HomeKVM.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HomeKVM"
        Description="One keyboard and mouse across your Windows PCs, with a shared clipboard and file paste."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start when I sign in"; off until the user turns it on in HomeKVM. -->
        <desktop:Extension Category="windows.startupTask" Executable="HomeKVM.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="HomeKVMStartup" Enabled="false" DisplayName="HomeKVM" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop app: keyboard and mouse hooks, SendInput, clipboard and networking. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
